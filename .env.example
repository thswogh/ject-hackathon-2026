OPENAI_API_KEY=sk-
OPENAI_MODEL=gpt-4o-mini
# hybrid(기본): 사실은 docs/fallback.md 기록, 문구만 AI (약 3~6초)
# ai: AI가 웹 검색으로 판독 (느리고 사실 오류 위험) / curated: AI 없이 기록과 템플릿만
JUDGE_SOURCE=hybrid
# 실시간 발굴 (docs/spec.md 7.9): 판독 뒤 백그라운드에서 웹 검색으로 새 기록을 찾아 쌓는다
DISCOVERY_MODEL=gpt-5-mini
DISCOVERY_DAILY_LIMIT=50
# Vercel Storage에서 Upstash Redis를 연결하면 KV_REST_API_URL/TOKEN이 자동으로 들어온다. 비우면 서버 메모리(로컬용)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
